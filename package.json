{
  "name": "any-ai-tasks",
  "version": "1.0.0",
  "description": "Shared dependencies for all Node.js tasks",
  "private": true,
  "scripts": {
    "test:all": "jest --testPathPattern=\"Task(3|4|6|7|8|9|10)\" && node --test Task11/tests/EventEmitter.test.js",
    "test:t3": "jest --testPathPattern=Task3",
    "test:t4": "jest --testPathPattern=Task4",
    "test:t6": "jest --testPathPattern=Task6",
    "test:t7": "jest --testPathPattern=Task7",
    "test:t8": "jest --testPathPattern=\"Task8.*tests\"",
    "test:t9": "jest --testPathPattern=Task9",
    "test:t10": "jest --testPathPattern=Task10",
    "test:t11": "node --test Task11/tests/EventEmitter.test.js",
    "test:t12": "python -m pytest Task12/test.py",
    "start:t4": "node Task4/cli.js",
    "start:t6": "node Task6/cli.js",
    "start:t7": "node Task7/example.js",
    "start:t8": "node Task8/demo.js",
    "start:t9": "node Task9/demo.js",
    "start:t10": "node Task10/demo.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/Task3/**/*.test.js",
      "**/Task4/**/*.test.js",
      "**/Task6/**/*.test.js",
      "**/Task7/**/*.test.js",
      "**/Task8/**/tests/*.test.js",
      "**/Task9/**/*.test.js",
      "**/Task10/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/Task11/"
    ]
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "dependencies": {
    "inquirer": "^8.2.7"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soumyacodes13/practice.tasks.git"
  },
  "bugs": {
    "url": "https://github.com/soumyacodes13/practice.tasks/issues"
  },
  "homepage": "https://github.com/soumyacodes13/practice.tasks#readme"
}
